# Sao chép thành .env và điền key. KHÔNG commit file .env
# Một key Gemini dùng cho cả lập plan (Gemini) lẫn sinh video (Veo)
GEMINI_API_KEY=
# gemini (mặc định) | claude — model lập plan. Chỉ cần ANTHROPIC_API_KEY khi chọn claude
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
# fake = không tốn tiền (mặc định khi dev) | veo = gọi Veo thật
VIDEO_PROVIDER=fake
# fake | fpt | google
TTS_PROVIDER=fake
FPT_TTS_API_KEY=
